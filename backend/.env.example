APP_NAME=Resume Studio AI
APP_VERSION=1.0.0
DEBUG=false

STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://rsai:rsai@localhost:5432/rsai

OMNIROUTE_API_URL=http://localhost:20128/v1/chat/completions
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=oc/big-pickle
OMNIROUTE_TIMEOUT=60
OMNIROUTE_MAX_RETRIES=1
ALLOW_MOCK_AI_DATA=false

JWT_SECRET_KEY=change-me-to-a-random-256-bit-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Origins allowed to embed generated resume preview HTML in an iframe (designer).
# Space-separated CSP frame-ancestors. Override for production (e.g. https://app.example.com).
FRAME_ANCESTORS='self' http://localhost:5173 http://127.0.0.1:5173
